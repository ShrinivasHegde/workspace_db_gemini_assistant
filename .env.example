# Copy this file to .env.secrets.local for local development. It is ignored by Git.
# The tracked .env.local and .env.prod files contain safe application defaults.
GEMINI_API_KEY=replace_with_your_new_key
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Application-owned chat history database.
APP_DATABASE_URL=postgresql://postgres:root@localhost:5432/analyse_db
# Database whose schema the assistant reads (use a dedicated read-only account).
TARGET_DATABASE_URL=postgresql://readonly_user:password@localhost:5432/database_to_analyze
